# Example only. Node does not load this automatically; use hosting secrets or
# node --env-file=.env server.js for local configuration. Never commit .env.
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=/absolute/private/path/ecotourism.db
OAUTH_PUBLIC_URL=https://api.your-domain.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Independently generate AUTH_CODE_SECRET and TOKEN_ENCRYPTION_KEY with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
AUTH_CODE_SECRET=
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
APPLE_SERVICE_ID=
APPLE_CLIENT_SECRET=
